{
  "name": "insightforge-ai-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright/Chromium browser E2E suite for InsightForge AI (streamlit_app/) - additive to the Python project, does not replace pytest.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report e2e-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.5",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "typescript": "^5.6.3"
  }
}
