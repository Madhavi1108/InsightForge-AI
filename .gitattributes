# Normalize line endings - keep LF in the repo, check out native on Windows
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.ini   text eol=lf

# Binary / tool-managed
*.pdf   binary
*.pbix  binary
*.xlsx  binary
*.pkl   binary
*.png   binary
*.yxmd  text eol=crlf
