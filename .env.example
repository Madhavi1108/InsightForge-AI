# ===========================================================================
# InsightForge AI - Environment configuration TEMPLATE
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ===========================================================================

# --- Application --------------------------------------------------------------
INSIGHTFORGE_ENV=development           # development | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# --- PostgreSQL (Phase 7+) -------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insightforge
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=change_me_in_dot_env
# Full SQLAlchemy URL is derived from the parts above; override only if needed:
# DATABASE_URL=postgresql+psycopg2://insightforge:change_me@localhost:5432/insightforge

# --- pgAdmin (optional; only used by the compose 'tools' profile) ----------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@insightforge.local
PGADMIN_DEFAULT_PASSWORD=change_me_in_dot_env

# --- Pipeline paths (relative to project root unless absolute) -------------
DATA_INCOMING_DIR=data/incoming
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REJECTED_DIR=data/rejected
DATA_ARCHIVE_DIR=data/archive
REPORTS_DIR=reports
LOGS_DIR=logs

# --- Data contract / schema validation (Phase 11) ----------------------
DATA_CONTRACT_PATH=config/data_contract.yaml

# --- Data quality thresholds (Phase 14) ----------------------------------
DQ_PASS_THRESHOLD=95.0
DQ_WARN_THRESHOLD=90.0

# --- Alteryx integration (Phase 12-13) ---------------------------------------
# Path to AlteryxEngineCmd.exe. Leave blank to use the Python ETL fallback.
ALTERYX_ENGINE_CMD=
ALTERYX_WORKFLOW_DIR=alteryx

# --- LLM / AI Analyst (Phase 27+) -------------------------------------------
LLM_PROVIDER=gemini                    # gemini | none (template fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
LLM_TIMEOUT_SECONDS=30
NL_SQL_ROW_LIMIT=1000
NL_SQL_STATEMENT_TIMEOUT_MS=5000

# --- Email / Alerts (Phase 34) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=insightforge@example.com
ALERT_EMAIL_TO=manager@example.com

# --- File watcher (Phase 10) ---------------------------------------------
WATCH_SETTLE_SECONDS=2                 # a new file's size must be stable this long

# --- Scheduler (Phase 35 automation) --------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 8 * * *               # daily 08:00

# --- Reproducibility -------------------------------------------------------
RANDOM_SEED=20260909
